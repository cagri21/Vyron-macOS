    },
    "voiceListeningHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause when you finish speaking to send your message."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajınızı göndermek için konuşmanız bittiğinde duraklayın."
