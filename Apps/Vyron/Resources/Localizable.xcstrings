{
  "sourceLanguage": "en",
  "strings": {
    "folderAttachmentApplicationAnalysisPrompt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I’ve attached one or more applications."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir veya daha fazla uygulama ekledim."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До повідомлення прикріплено одну або кілька програм."
          }
        }
      }
    },
    "folderAttachmentApplicationOpen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uygulamasını aç"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрити %@"
          }
        }
      }
    },
    "folderAttachmentApplicationReady": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applications ready to attach"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar eklemeye hazır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програми готові до прикріплення"
          }
        }
      }
    },
    "folderAttachmentApplicationTooMany": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach up to %d applications per message."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesaj başına en fazla %d uygulama ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прикріпіть не більше %d програм до одного повідомлення."
          }
        }
      }
    },
    "folderAttachmentChooseFolder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach a folder…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasör ekle…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додати папку…"
          }
        }
      }
    },
    "folderAttachmentFileChoose": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach files…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya ekle…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прикріпити файли…"
          }
        }
      }
    },
    "folderAttachmentFileUnsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file type is unsupported: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya türü desteklenmiyor: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Непідтримуваний тип файлу: %@"
          }
        }
      }
    },
    "folderAttachmentFileTooMany": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach up to %d audio and text files per message."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesaj başına en fazla %d ses ve metin dosyası ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прикріпіть до %d аудіо- й текстових файлів до повідомлення."
          }
        }
      }
    },
    "folderAttachmentFilePrivacyHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File names and available text or transcripts go to %@ when you send the message."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajı gönderdiğinizde dosya adları ve mevcut metin veya dökümler %@ bağlantısına gönderilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після надсилання повідомлення назви файлів і доступний текст або транскрипції буде передано до %@."
          }
        }
      }
    },
    "folderAttachmentFileAudioNoTranscript": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No on-device transcript is available. The model receives the name and duration."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aygıtta oluşturulmuş bir döküm yok. Model dosya adını ve süresini alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транскрипція на пристрої недоступна. Модель отримає назву й тривалість файлу."
          }
        }
      }
    },
    "folderAttachmentFileReady": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files ready to attach"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalar eklenmeye hazır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файли готові до прикріплення"
          }
        }
      }
    },
    "folderAttachmentFileLimited": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only an excerpt will be included."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bir alıntı gönderilecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Буде додано лише уривок."
          }
        }
      }
    },
    "folderAttachmentFileDroppedName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dropped audio"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürüklenen ses"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягнуте аудіо"
          }
        }
      }
    },
    "folderAttachmentFileAudioType": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудіо"
          }
        }
      }
    },
    "folderAttachmentFileDocumentType": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст"
          }
        }
      }
    },
    "folderAttachmentFileAnalysisPrompt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyze the attached files. Summarize what you can determine and mention any unavailable content."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekli dosyaları analiz et. Çıkarabildiğin bilgileri özetle ve erişilemeyen içerikleri belirt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проаналізуй прикріплені файли. Підсумуй те, що вдалося визначити, і зазнач, який вміст був недоступний."
          }
        }
      }
    },
    "folderAttachmentFileContextTooLarge": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The files exceed the analysis limit. Remove a file or shorten your message."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalar analiz sınırını aşıyor. Bir dosyayı kaldırın veya mesajınızı kısaltın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файли перевищують ліміт аналізу. Вилучіть файл або скоротіть повідомлення."
          }
        }
      }
    },
    "folderAttachmentImporting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing attachments…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekler hazırlanıyor…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підготовка вкладень…"
          }
        }
      }
    },
    "folderAttachmentAnalysisPrompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyze the attached folders. Summarize their structure and the supplied file contents, identify issues, and suggest improvements. Clearly state any coverage limits."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eklenen klasörleri analiz et. Yapılarını ve sağlanan dosya içeriklerini özetle, sorunları belirle ve iyileştirmeler öner. İncelemenin kapsam sınırlarını açıkça belirt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проаналізуй додані папки. Підсумуй їхню структуру та наданий вміст файлів, визнач проблеми й запропонуй поліпшення. Чітко зазнач обмеження охоплення."
          }
        }
      }
    },
    "folderAttachmentReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder ready to analyze"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasör analize hazır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка готова до аналізу"
          }
        }
      }
    },
    "folderAttachmentRemove": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ klasörünü kaldır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вилучити %@"
          }
        }
      }
    },
    "folderAttachmentSummary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d files included · %d skipped"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%d dosya eklendi · %d atlandı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додано файлів: %d · пропущено: %d"
          }
        }
      }
    },
    "folderAttachmentLimited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some contents were omitted to fit the analysis limit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiz sınırına uymak için bazı içerikler dahil edilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Частину вмісту пропущено через обмеження обсягу аналізу."
          }
        }
      }
    },
    "folderAttachmentPdfAnalysisPrompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyze the attached material and summarize the relevant findings. Identify any limits in the supplied content."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eklenen içeriği incele ve ilgili bulguları özetle. Sağlanan içerikteki sınırları belirt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проаналізуй додані матеріали й підсумуй важливі висновки. Зазнач обмеження наданого вмісту."
          }
        }
      }
    },
    "folderAttachmentPdfChoose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach PDFs…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF ekle…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додати PDF…"
          }
        }
      }
    },
    "folderAttachmentPdfContextTooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PDFs and other draft material exceed the analysis limit. Remove an attachment or shorten your message."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF’ler ve diğer taslak içeriği analiz sınırını aşıyor. Bir eki kaldırın veya iletinizi kısaltın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF та інші матеріали чернетки перевищують ліміт аналізу. Видаліть вкладення або скоротіть повідомлення."
          }
        }
      }
    },
    "folderAttachmentPdfDroppedName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dropped document.pdf"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bırakılan belge.pdf"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягнутий документ.pdf"
          }
        }
      }
    },
    "folderAttachmentPdfLimited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only part of this PDF’s text fits within the analysis limits."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu PDF’nin metninin yalnızca bir bölümü analiz sınırlarına sığıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У межах ліміту аналізу доступна лише частина тексту цього PDF."
          }
        }
      }
    },
    "folderAttachmentPdfNoPreview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first page preview is unavailable."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk sayfanın önizlemesi kullanılamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Попередній перегляд першої сторінки недоступний."
          }
        }
      }
    },
    "folderAttachmentPdfNoText": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This PDF has no readable text within the analysis limits. Choose a PDF with selectable text."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu PDF’de analiz sınırları içinde okunabilir metin yok. Seçilebilir metin içeren bir PDF seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У межах ліміту аналізу в цьому PDF немає читабельного тексту. Виберіть PDF із текстом, який можна виділити."
          }
        }
      }
    },
    "folderAttachmentPdfPreview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview first page of %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dosyasının ilk sayfasını önizle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглянути першу сторінку %@"
          }
        }
      }
    },
    "folderAttachmentPdfPrivacyHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you send, %@ receives text extracted locally from the PDF. The preview and text are saved in this chat’s history."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderdiğinizde, %@ PDF’den yerel olarak çıkarılan metni alır. Önizleme ve metin bu sohbetin geçmişine kaydedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час надсилання %@ отримує текст, видобутий із PDF на цьому Mac. Попередній перегляд і текст зберігаються в історії цього чату."
          }
        }
      }
    },
    "folderAttachmentPdfReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF ready to analyze"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF analize hazır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF готовий до аналізу"
          }
        }
      }
    },
    "folderAttachmentFileDocumentUnsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a supported text file such as TXT, Markdown, CSV, or JSON."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TXT, Markdown, CSV veya JSON gibi desteklenen bir metin dosyası seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть підтримуваний текстовий файл, наприклад TXT, Markdown, CSV або JSON."
          }
        }
      }
    },
    "folderAttachmentFileDocumentUnreadable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyron couldn’t read this text file. Choose a regular file encoded as UTF-8 or UTF-16 with a byte order mark."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyron bu metin dosyasını okuyamadı. UTF-8 veya bayt sırası işareti içeren UTF-16 kodlamalı bir normal dosya seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyron не вдалося прочитати цей текстовий файл. Виберіть звичайний файл у кодуванні UTF-8 або UTF-16 з позначкою порядку байтів."
          }
        }
      }
    },
    "folderAttachmentFileDocumentTooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This text file exceeds the %d MiB import limit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu metin dosyası %d MiB içe aktarma sınırını aşıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей текстовий файл перевищує ліміт імпорту в %d МіБ."
          }
        }
      }
    },
    "folderAttachmentFileDocumentNoText": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This text file is empty."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu metin dosyası boş."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей текстовий файл порожній."
          }
        }
      }
    },
    "folderAttachmentPdfTooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This PDF exceeds the %d MiB import limit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu PDF, %d MiB içe aktarma sınırını aşıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
