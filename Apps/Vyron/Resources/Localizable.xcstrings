    "privacyMicrophoneUsage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyron uses your microphone when you choose dictation or start a voice conversation."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
