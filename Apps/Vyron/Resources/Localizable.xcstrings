          }
        }
      }
    },
    "appSettingsMemoryExplanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download sizes describe model weights, not total running memory. Context, Xcode, Simulator, and other apps need additional memory. Agent tasks require working native tool calls; Chat can use models without tools."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirme boyutları, toplam çalışma belleğini değil model ağırlıklarını gösterir. Bağlam, Xcode, Simulator ve diğer uygulamalar ek bellek gerektirir. Ajan görevleri çalışan yerel araç çağrıları gerektirir; Sohbet, araçsız modelleri kullanabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розміри завантажень стосуються ваг моделі, а не загальної оперативної пам’яті. Контексту, Xcode, Simulator та іншим програмам потрібна додаткова пам’ять. Завдання агента потребують робочих нативних викликів інструментів; чат може використовувати моделі без інструментів."
          }
        }
      }
    },
    "appSettingsLocalInference": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local inference"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel çıkarım"
          }
        },
        "uk": {
