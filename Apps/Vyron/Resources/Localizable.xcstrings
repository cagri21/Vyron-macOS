    "modelDataClaudeToolArgumentsTooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude returned oversized native tool arguments."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude, yerleşik araç için boyut sınırını aşan bağımsız değişkenler döndürdü."
          }
        },
        "uk": {
          "stringUnit": {
