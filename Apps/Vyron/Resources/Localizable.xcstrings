    "localAuthEncryptionKeyMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The existing backup’s encryption key is missing. Saved API keys were preserved."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut yedeğin şifreleme anahtarı bulunamadı. Kayıtlı API anahtarları korundu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ шифрування наявної резервної копії відсутній. Збережені ключі API не змінено."
          }
        }
      }
    },
    "localAuthUnauthorized": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local service rejected this Mac. Check the local authentication setup."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel hizmet bu Mac’in erişimini reddetti. Yerel kimlik doğrulama kurulumunu kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальна служба відхилила цей Mac. Перевірте налаштування локальної автентифікації."
          }
        }
      }
    },
    "localAuthInvalidConfiguration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the local authentication settings. Check the setup."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel kimlik doğrulama ayarları okunamıyor. Kurulumu kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
