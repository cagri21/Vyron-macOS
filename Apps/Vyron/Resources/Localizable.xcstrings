    "officeSetupHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install the DeepSeek Harness SDK and its Office runtime once, then choose that environment's Python executable. PDF page images work without this setup. Changes apply to new tasks."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek Harness SDK'sını ve Office çalışma ortamını bir kez yükleyin, ardından o ortamın Python dosyasını seçin. PDF sayfa görselleri bu kurulum olmadan çalışır. Değişiklikler yeni görevlere uygulanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один раз установіть SDK DeepSeek Harness і середовище Office, а потім виберіть Python цього середовища. Зображення сторінок PDF працюють без цього налаштування. Зміни застосовуються до нових завдань."
          }
        }
      }
    },
