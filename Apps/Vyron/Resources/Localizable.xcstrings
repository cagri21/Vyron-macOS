        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude örnekleme ve düşünme ayarlarını kendi yönetir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude самостійно керує вибіркою й параметрами міркування."
          }
        }
      }
    },
    "modelDataClaudeStreamIncomplete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Claude response stream ended before completion."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude'un yanıt akışı tamamlanmadan sona erdi."
          }
