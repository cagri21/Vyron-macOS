          }
        }
      }
    },
    "screenshotImageTooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image exceeds the attachment limit. Choose a smaller image or remove an attachment."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu resim ek sınırını aşıyor. Daha küçük bir resim seçin veya bir eki kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зображення перевищує обмеження вкладень. Виберіть менше зображення або видаліть вкладення."
          }
