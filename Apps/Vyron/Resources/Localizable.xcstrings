    "pluginsEditorPermissionsHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read only exposes tools the server identifies as read-only. Ask before changes also exposes write tools in Agent, with a review of each call. Plan never receives write tools."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salt okunur, yalnızca sunucunun salt okunur olarak tanımladığı araçları sunar. Değişikliklerden önce sor, Ajan’da her çağrının incelenmesiyle yazma araçlarını da sunar. Plan’a hiçbir zaman yazma araçları verilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим «Лише читання» надає тільки інструменти, які сервер визначає як доступні лише для читання. Режим «Запитувати перед змінами» також надає Агенту інструменти запису з перевіркою кожного виклику. План ніколи не отримує інструментів запису."
          }
        }
      }
    },
    "pluginsEditorSave": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save connection"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantıyı kaydet"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберегти підключення"
          }
        }
      }
    },
    "pluginsEditorInvalidForm": {
      "extractionState": "manual",
