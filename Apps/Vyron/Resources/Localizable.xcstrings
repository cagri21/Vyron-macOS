            "state": "translated",
            "value": "The server changed. Previous credentials were cleared; enter credentials for this server below."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu değişti. Önceki kimlik bilgileri temizlendi; aşağıya bu sunucunun kimlik bilgilerini girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер змінено. Попередні облікові дані очищено; введіть нижче облікові дані цього сервера."
          }
        }
      }
    },
    "pluginsEditorUnavailableJSON": {
      "extractionState": "manual",
      "localizations": {
