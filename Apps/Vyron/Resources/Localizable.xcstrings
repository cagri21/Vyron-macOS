    "appAutomationAgentHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe the outcome naturally. The agent chooses an app, adjusts its reasoning effort, performs routine actions, and decides when to check again. Sensitive or unfamiliar actions ask for your review."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstediğiniz sonucu doğal bir dille anlatın. Ajan bir uygulama seçer, düşünme düzeyini ayarlar, rutin eylemleri gerçekleştirir ve ne zaman yeniden kontrol edeceğine karar verir. Hassas veya tanınmayan eylemler için incelemenizi ister."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Опишіть бажаний результат звичайними словами. Агент вибере програму, налаштує рівень міркування, виконає звичні дії й вирішить, коли перевірити знову. Чутливі або незнайомі дії потребують вашого перегляду."
          }
        }
      }
    },
    "appAutomationTaskHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe your goal. Vyron reads the selected app, proposes the next step, and checks progress after each action you approve. Your selected app stays fixed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedefinizi anlatın. Vyron seçili uygulamayı okur, sonraki adımı önerir ve onayladığınız her eylemden sonra ilerlemeyi denetler. Seçili uygulama aynı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Опишіть ціль. Vyron прочитає стан вибраної програми, запропонує наступний крок і перевірить результат кожної схваленої дії. Вибрана програма залишається незмінною."
          }
        }
      }
    },
    "appAutomationOneActionHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe one action. The model proposes a step for you to review; it never executes the proposal itself."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek bir eylem anlatın. Model, incelemeniz için bir adım önerir; öneriyi kendisi gerçekleştirmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Опишіть одну дію. Модель запропонує крок для вашого перегляду; сама вона його не виконує."
          }
        }
      }
    },
