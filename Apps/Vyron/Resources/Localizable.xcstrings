    "chromeRefresh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh connection"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantıyı yenile"
