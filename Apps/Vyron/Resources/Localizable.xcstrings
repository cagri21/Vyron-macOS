    "appAutomationMonitorHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads only the app you select. No automatic AI requests or control actions. Monitoring stops when you close this panel or select another app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca seçtiğiniz uygulamayı okur. Otomatik yapay zeka isteği veya denetim eylemi yapmaz. Bu paneli kapattığınızda veya başka bir uygulama seçtiğinizde izleme durur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає лише вибрану програму. Без автоматичних запитів до ШІ або дій керування. Спостереження зупиняється, коли ви закриваєте панель або вибираєте іншу програму."
          }
        }
      }
    },
    "appAutomationChangesHint": {
      "localizations": {
