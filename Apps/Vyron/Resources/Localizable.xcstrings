    "officeDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert documents to PDF, render page images, and recalculate spreadsheets on this Mac. Work asks before creating output files."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belgeleri PDF'ye dönüştürün, sayfa görselleri oluşturun ve hesap tablolarını bu Mac'te yeniden hesaplayın. Work, çıktı dosyaları oluşturmadan önce izin ister."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетворюйте документи на PDF, створюйте зображення сторінок і перераховуйте таблиці на цьому Mac. Work запитує дозвіл перед створенням вихідних файлів."
          }
        }
      }
    },
