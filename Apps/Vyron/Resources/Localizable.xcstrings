    "modelDomainSettingsOutputExceedsContext": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum output must be smaller than the context window."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En yüksek çıktı, bağlam penceresinden küçük olmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Максимальний обсяг виведення має бути меншим за вікно контексту."
          }
        }
      }
    },
    "modelDataApiKeyTooLong": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The API key contains invalid characters or is too long."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "API anahtarı geçersiz karakterler içeriyor veya çok uzun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ API містить неприпустимі символи або задовгий."
          }
        }
      }
    },
    "modelDataApiKeyUnsupportedCharacters": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The API key contains unsupported characters."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "API anahtarı desteklenmeyen karakterler içeriyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ API містить непідтримувані символи."
          }
        }
      }
    },
    "modelDataConnectionNameLimit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give this connection a name of at most %ld characters."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bağlantıya en fazla %ld karakterlik bir ad verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва цього підключення має містити щонайбільше %ld символів."
          }
        }
      }
    },
    "modelDataConnectionThinkingUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thinking controls are unavailable for this server and model selection."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sunucu ve model seçimi için düşünme ayarları kullanılamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для вибраного сервера й моделі налаштування міркування недоступні."
          }
        }
      }
    },
    "modelDataDuplicateOrTooManyConnections": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved model connections contain duplicate profiles or too many connections."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı model bağlantılarında yinelenen profiller var veya bağlantı sayısı sınırı aşılıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Серед збережених підключень моделей є повторювані профілі або перевищено допустиму кількість підключень."
          }
        }
      }
    },
    "modelDataActiveConnectionMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved active model connection is missing."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı etkin model bağlantısı bulunamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережене активне підключення моделі відсутнє."
          }
        }
      }
    },
    "modelDataConnectionFileTooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved model connections file is too large."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model bağlantılarının kayıt dosyası çok büyük."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл збережених підключень моделей завеликий."
          }
        }
      }
    },
    "modelDataCredentialUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model API key could not be accessed in Keychain. Unlock your login keychain or enter the key again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar Zinciri'ndeki model API anahtarına erişilemedi. Oturum açma anahtar zincirinizin kilidini açın veya anahtarı yeniden girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося отримати доступ до ключа API моделі у В’язці ключів. Відімкніть в’язку ключів входу або введіть ключ знову."
          }
        }
      }
    },
    "modelDataSourceInvalidURL": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter an HTTPS model URL without a username, password, or fragment."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcı adı, parola veya parça tanımlayıcısı içermeyen bir HTTPS model adresi girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть HTTPS-адресу моделі без імені користувача, пароля чи фрагмента."
          }
        }
      }
    },
    "modelDataSourceUnsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use an Ollama model page, a public Hugging Face GGUF repository, or a direct .gguf download URL."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Ollama model sayfası, herkese açık bir Hugging Face GGUF deposu veya doğrudan .gguf indirme adresi kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використайте сторінку моделі Ollama, загальнодоступний репозиторій GGUF на Hugging Face або пряму адресу завантаження .gguf."
          }
        }
      }
    },
    "modelDataSourceNoVariants": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This source did not publish any supported model variants. Try a public GGUF repository or an exact Ollama model tag."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kaynakta desteklenen model varyantı yayımlanmamış. Herkese açık bir GGUF deposunu veya tam bir Ollama model etiketini deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цьому джерелі немає опублікованих підтримуваних варіантів моделі. Спробуйте загальнодоступний репозиторій GGUF або точний тег моделі Ollama."
          }
        }
      }
    },
    "modelDataSourceHTTPStatus": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model source returned HTTP %@. Check the URL and whether the model is publicly accessible."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model kaynağı HTTP %@ kodunu döndürdü. Adresi ve modelin herkese açık olup olmadığını kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Джерело моделі повернуло HTTP %@. Перевірте адресу й переконайтеся, що модель загальнодоступна."
          }
        }
      }
    },
    "modelDataSourceInvalidMetadata": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model source returned unreadable variant information."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model kaynağı okunamayan varyant bilgileri döndürdü."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Джерело моделі повернуло дані про варіант, які не вдалося прочитати."
          }
        }
      }
    },
    "modelDataSourceMetadataTooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source contains too many files. Use a more specific repository folder or a direct GGUF URL."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynakta çok fazla dosya var. Deponun daha belirli bir klasörünü veya doğrudan bir GGUF adresini kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У джерелі забагато файлів. Укажіть конкретнішу папку репозиторію або пряму адресу GGUF."
          }
        }
      }
    },
    "modelDataSourceInvalidGGUF": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The downloaded file is not a supported GGUF model. It may be an HTML page, a Git LFS pointer, or an incomplete download."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilen dosya desteklenen bir GGUF modeli değil. Dosya bir HTML sayfası, Git LFS işaretçisi veya tamamlanmamış bir indirme olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажений файл не є підтримуваною моделлю GGUF. Це може бути HTML-сторінка, покажчик Git LFS або неповністю завантажений файл."
          }
        }
      }
    },
    "modelDataSourceSplitGGUF": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is one part of a split GGUF model. Choose a single-file GGUF variant; importing split models is not supported yet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya bölünmüş bir GGUF modelinin parçası. Tek dosyalı bir GGUF varyantı seçin. Bölünmüş modeller henüz içe aktarılamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це частина розділеної моделі GGUF. Виберіть варіант GGUF в одному файлі. Імпорт розділених моделей ще не підтримується."
          }
        }
      }
    },
    "modelDataSourceInvalidLocalEndpoint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model files can be imported only into Ollama running on this Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model dosyaları yalnızca bu Mac'te çalışan Ollama'ya aktarılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файли моделей можна імпортувати лише в Ollama, запущену на цьому Mac."
          }
        }
      }
    },
    "modelDataSourceImportFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama could not import the model. %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama modeli içe aktaramadı. %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama не змогла імпортувати модель. %@"
          }
        }
      }
    },
    "modelDataSourceModelAlreadyExists": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That local model name already exists. Choose another name to keep the installed model."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yerel model adı zaten kullanılıyor. Yüklü modeli korumak için başka bir ad seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель із таким іменем уже є. Виберіть інше ім’я, щоб зберегти встановлену модель."
          }
        }
      }
    },
    "modelDataSourceArchitectureRejected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The runtime rejected this model's architecture or GGUF data. Check Ollama's compatibility with this model."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışma zamanı bu modelin mimarisini veya GGUF verilerini reddetti. Modelin Ollama ile uyumluluğunu kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Середовище виконання відхилило архітектуру цієї моделі або дані GGUF. Перевірте сумісність моделі з Ollama."
          }
        }
      }
    },
    "modelDataSourceImportIncomplete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The runtime stopped before confirming success."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışma zamanı işlemin başarılı olduğunu onaylamadan durdu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Середовище виконання зупинилося, перш ніж підтвердити успішний імпорт."
          }
        }
      }
    },
    "modelDataInvalidToolCatalog": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connected tool catalog is too large or contains invalid schemas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlı araç kataloğu çok büyük veya geçersiz şemalar içeriyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Каталог підключених інструментів завеликий або містить неприпустимі схеми."
          }
        }
      }
    },
    "modelDataClaudeManagedControls": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude uses model-managed sampling and thinking controls."
