          }
        }
      }
    },
    "pluginsEditorInvalidJSON": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the JSON syntax. Credential fields must be JSON objects with text values."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON sözdizimini kontrol edin. Kimlik bilgisi alanları, metin değerleri içeren JSON nesneleri olmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте синтаксис JSON. Поля облікових даних мають бути об’єктами JSON із текстовими значеннями."
          }
        }
      }
    },
    "pluginsReviewTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review integration action"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entegrasyon eylemini incele"
          }
        },
        "uk": {
