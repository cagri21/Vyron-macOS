          }
        }
      }
    },
    "localAuthIntegrityFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The encrypted backup could not be verified. Saved API keys were preserved."
          }
