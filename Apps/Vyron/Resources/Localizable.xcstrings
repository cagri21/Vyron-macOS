    "appSettingsQwen38Summary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Newer coding and reasoning model; recommended to try locally."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha yeni kodlama ve akıl yürütme modeli; yerel olarak denemeniz önerilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Новіша модель для програмування й міркування; рекомендовано спробувати локально."
          }
        }
      }
    },
    "appSettingsQwen38Memory": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with one loaded model and a 32K context."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüklü tek model ve 32K bağlamla başlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почніть з однієї завантаженої моделі й контексту 32K."
          }
        }
      }
    },
    "appSettingsQwen36Summary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixture-of-experts alternative for coding and reasoning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodlama ve akıl yürütme için uzmanlar karışımı mimarili alternatif."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Альтернатива для програмування й міркування на основі суміші експертів."
          }
        }
      }
    },
    "appSettingsQwen36Memory": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "23 GB weights; keep a 32K context and one model loaded."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "23 GB ağırlık; 32K bağlam ve yüklü tek model kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваги 23 ГБ; використовуйте контекст 32K й одну завантажену модель."
          }
        }
      }
    },
    "appSettingsDevstralSummary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Software engineering model for repository exploration and editing."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depo inceleme ve düzenleme için yazılım mühendisliği modeli."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель програмної інженерії для дослідження й редагування репозиторію."
          }
        }
      }
    },
    "appSettingsDevstralMemory": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "15 GB weights; a smaller download among the coding options."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "15 GB ağırlık; kodlama seçenekleri arasında daha küçük bir indirme."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваги 15 ГБ; менший розмір завантаження серед моделей для програмування."
          }
        }
      }
    },
    "appSettingsQwenCoderSummary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The coding baseline used for the app's initial build-and-repair proof."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın ilk derleme ve düzeltme doğrulamasında kullanılan temel kodlama modeli."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Базова модель для програмування, використана в початковій перевірці збирання й виправлення програми."
          }
        }
      }
    },
    "appSettingsQwenCoderMemory": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "19 GB weights; start with a 32K context."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "19 GB ağırlık; 32K bağlamla başlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваги 19 ГБ; почніть із контексту 32K."
          }
        }
      }
    },
    "appSettingsQwenNextSummary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large agentic coding model. Optional, explicit selection only."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyük ajan tabanlı kodlama modeli. İsteğe bağlıdır, yalnızca açık seçimle kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Велика агентна модель для програмування. Необов’язкова, доступна лише за явним вибором."
          }
        }
      }
    },
    "appSettingsQwenNextMemory": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "52 GB weights leave little headroom on a 64 GB Mac. Excluded from Auto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "52 GB ağırlık, 64 GB Mac’te az boş alan bırakır. Otomatik seçime dahil edilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваги 52 ГБ залишають мало вільної пам’яті на Mac із 64 ГБ. Не входить до автоматичного вибору."
          }
        }
      }
    },
    "appSettingsQwenHelperSummary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightweight intent routing and chat helper; not a development model."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafif niyet yönlendirme ve sohbet yardımcısı; geliştirme modeli değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Легка допоміжна модель для визначення намірів і чату; не призначена для розробки."
          }
        }
      }
    },
    "appSettingsQwenHelperMemory": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2.5 GB download. Kept separate from coding-model selection."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2,5 GB indirme. Kodlama modeli seçiminden ayrı tutulur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантаження 2,5 ГБ. Вибирається окремо від моделей для програмування."
          }
        }
      }
    },
