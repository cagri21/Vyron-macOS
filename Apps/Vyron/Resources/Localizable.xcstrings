    "modelDomainProviderOutputLimitReached": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model reached its output limit before completing the response. Try smaller file edits or increase the connection's output limit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model, yanıtı tamamlamadan çıktı sınırına ulaştı. Daha küçük dosya değişiklikleri deneyin veya bağlantının çıktı sınırını artırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель досягла ліміту виведення до завершення відповіді. Спробуйте вносити менші зміни до файлів або збільште ліміт виведення для підключення."
          }
        }
      }
    },
    "modelDomainProviderModelListUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server does not provide model discovery. Enter its exact model ID manually."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sunucu model keşfi sunmuyor. Modelin tam kimliğini elle girin."
