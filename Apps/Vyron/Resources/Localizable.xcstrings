    "localAuthDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connects automatically on this Mac. Keys stay in Keychain with an encrypted local backup."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac’te otomatik bağlanır. Anahtarlar Anahtar Zinciri’nde ve şifreli bir yerel yedekte saklanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключається автоматично на цьому Mac. Ключі зберігаються у В’язці ключів і в зашифрованій локальній копії."
          }
        }
      }
    },
