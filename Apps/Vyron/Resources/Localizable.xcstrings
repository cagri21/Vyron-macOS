    "controlSafetyLimit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task paused at its safety limit: up to 12 planning passes and 8 approved actions. Review the latest snapshot."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görev güvenlik sınırında duraklatıldı: en fazla 12 planlama turu ve 8 onaylı eylem. Son anlık görüntüyü inceleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завдання призупинено на межі безпеки: до 12 циклів планування та 8 схвалених дій. Перегляньте останній знімок."
          }
