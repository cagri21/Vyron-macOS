          }
        }
      }
    },
    "workspaceHighEffortDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complex debugging, multi-file changes, and production risks."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karmaşık hata ayıklama, çok dosyalı değişiklikler ve üretim ortamı riskleri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Складне налагодження, зміни в кількох файлах і ризики у виробничому середовищі."
          }
        }
      }
    },
    "workspaceExtraHighEffortDescription": {
      "extractionState": "manual",
      "localizations": {
