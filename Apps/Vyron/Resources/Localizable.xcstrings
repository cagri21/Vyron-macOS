    "appSettingsImportingNotice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Importing %@. Cancel the import before starting another; canceled file imports restart from the beginning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ içe aktarılıyor. Başka bir işlem başlatmadan önce içe aktarmayı iptal edin; iptal edilen dosya aktarmaları baştan başlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імпортується %@. Скасуйте імпорт перед початком іншого; скасований імпорт файлу починається спочатку."
          }
        }
      }
    },
    "appSettingsDownloadingNotice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloading %@. Pause its download before starting another."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ indiriliyor. Başka bir işlem başlatmadan önce indirmeyi duraklatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажується %@. Призупиніть завантаження перед початком іншого."
          }
        }
      }
    },
    "appSettingsSelectedUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your selected model, %@, is unavailable from this connection. Choose an available model or check its server; manual selection never falls back silently."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtiğiniz %@ modeli bu bağlantıda kullanılamıyor. Kullanılabilir bir model seçin veya sunucusunu denetleyin; elle seçimde sessizce başka modele geçilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрана модель %@ недоступна через це підключення. Виберіть доступну модель або перевірте сервер; ручний вибір не перемикається на іншу модель непомітно."
          }
        }
      }
