    "controlCompletionOldSnapshot": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The completion report used an old snapshot. Inspect the app and plan again to verify the current state."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamlanma raporunda eski bir anlık görüntü kullanıldı. Geçerli durumu doğrulamak için uygulamayı inceleyin ve yeniden planlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У звіті про завершення використано старий знімок. Перевірте програму та сплануйте знову, щоб підтвердити поточний стан."
          }
        }
