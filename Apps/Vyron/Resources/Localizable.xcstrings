    "skillsAutomaticSetupConflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A local skill already uses this name. Select it explicitly or rename it before automatic setup."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel bir beceri bu adı zaten kullanıyor. Beceriyi açıkça seçin veya otomatik kurulumdan önce yeniden adlandırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальна навичка вже використовує це ім’я. Виберіть її явно або перейменуйте перед автоматичним встановленням."
          }
        }
      }
    },
    "skillsAutomaticSetupTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic skill setup"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik beceri kurulumu"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматичне встановлення навичок"
          }
        }
      }
    },
    "skillsAutomaticSetupDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up built-in PDF, Word, spreadsheet, and presentation skills when a Work task needs them. Additional software may still be required."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Çalışma görevi gerektirdiğinde yerleşik PDF, Word, elektronik tablo ve sunum becerilerini kurar. Ek yazılım yine de gerekebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встановлюйте вбудовані навички PDF, Word, електронних таблиць і презентацій, коли вони потрібні для завдання в режимі Work. Може знадобитися додаткове програмне забезпечення."
          }
        }
      }
    },
    "skillsAutomaticSetupFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The required skill could not be set up. Check access to the skill folder and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerekli beceri kurulamadı. Beceri klasörüne erişimi denetleyip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося встановити потрібну навичку. Перевірте доступ до папки навичок і повторіть спробу."
          }
        }
      }
    },
    "skillsCompactDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shorten conversation context while keeping the full chat history."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbet geçmişini koruyarak konuşma bağlamını kısaltın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скоротіть контекст розмови, зберігши повну історію чату."
          }
        }
      }
    },
    "skillsSideDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a temporary side chat without interrupting the current conversation."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut sohbeti kesintiye uğratmadan geçici bir yan sohbet başlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почніть тимчасовий бічний чат, не перериваючи поточну розмову."
          }
        }
      }
    },
    "skillsCommandLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command"
