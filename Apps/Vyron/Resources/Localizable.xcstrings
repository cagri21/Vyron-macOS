    "screenshotReadyToAnalyze": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image attached. Describe what to inspect, compare, explain, or build, then send."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resim eklendi. İncelenecek, karşılaştırılacak, açıklanacak veya yapılacak şeyi yazıp gönderin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зображення додано. Опишіть, що перевірити, порівняти, пояснити чи створити, і надішліть."
          }
        }
      }
    },
    "screenshotAnalysisPrompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyze the attached screenshots. Describe what is visible, identify any interface issues, and suggest useful improvements."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekli ekran görüntülerini analiz et. Görünenleri açıkla, arayüz sorunlarını belirle ve yararlı iyileştirmeler öner."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проаналізуй вкладені знімки екрана. Опиши видимий вміст, визнач проблеми інтерфейсу та запропонуй корисні покращення."
          }
        }
      }
    },
