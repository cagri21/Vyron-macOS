        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потік відповіді Claude завершився завчасно."
          }
        }
      }
    },
    "modelDataClaudeStreamError": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude reported a response stream error."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude yanıt akışında bir hata bildirdi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude повідомив про помилку в потоці відповіді."
          }
