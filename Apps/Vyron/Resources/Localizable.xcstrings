    "voiceNoVoices": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No installed voices are available. Add a voice in System Settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüklü ses bulunamadı. Sistem Ayarları’ndan bir ses ekleyin."
