    "screenshotVisionRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a model that supports images. The selected model does not advertise vision support."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resimleri destekleyen bir model seçin. Seçili model görüntü desteği bildirmiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть модель із підтримкою зображень. Вибрана модель не заявляє такої підтримки."
          }
        }
      }
    },
    "screenshotAnalysisHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images use your selected mode and model, including when Auto is on. Choose a model that supports images."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resimler, Otomatik açıkken de seçili modu ve modeli kullanır. Resimleri destekleyen bir model seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зображення використовують вибрані режим і модель, навіть у режимі Авто. Виберіть модель із підтримкою зображень."
          }
        }
      }
    },
    "screenshotPrivacyHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images stay in the draft until Send and are saved in this chat’s history. Your model connection (%@) receives images or locally extracted text, depending on image support."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resimler, Gönder’e basılana kadar taslakta kalır ve bu sohbetin geçmişine kaydedilir. Model bağlantınız (%@), görüntü desteğine göre resimleri veya yerel olarak çıkarılan metni alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зображення залишаються в чернетці до надсилання й зберігаються в історії цього чату. Ваше підключення до моделі (%@) отримує зображення або локально видобутий текст залежно від підтримки зображень."
          }
        }
      }
    },
    "screenshotImportImages": {
      "extractionState": "manual",
      "localizations": {
        "en": {
