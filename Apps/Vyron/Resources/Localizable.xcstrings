    "compactionPreparing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compacting conversation context…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşma bağlamı kısaltılıyor…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
