      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file is not a readable image. Choose a PNG, JPEG, HEIC, or another supported image."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya okunabilir bir resim değil. PNG, JPEG, HEIC veya desteklenen başka bir resim seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
