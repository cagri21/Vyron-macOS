    "modelDomainImageTooMany": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach up to four images in one request. Remove older images or start a new chat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir isteğe en fazla dört görsel ekleyin. Önceki görselleri kaldırın veya yeni bir sohbet başlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додавайте до чотирьох зображень на запит. Видаліть попередні зображення або почніть новий чат."
          }
        }
      }
    },
    "modelDomainImageInvalidSize": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each image must contain data and be no larger than %@ MB."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her görsel veri içermeli ve %@ MB'ı aşmamalıdır."
