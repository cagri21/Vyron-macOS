          }
        }
      }
    },
    "pluginsReviewDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This tool may change the connected service. Review what Agent is asking it to do."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu araç bağlı hizmette değişiklik yapabilir. Ajan’ın ne yapmasını istediğini inceleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей інструмент може змінити підключений сервіс. Перевірте, яку дію запитує Агент."
          }
        }
      }
    },
    "pluginsReviewRetryWarning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopping a request after it starts may leave changes in the connected service. Check the result there before retrying."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir isteği başladıktan sonra durdurmak, bağlı hizmette değişiklik bırakabilir. Yeniden denemeden önce sonucu orada kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо зупинити запит після початку, у підключеному сервісі можуть залишитися зміни. Перевірте результат у ньому перед повторною спробою."
          }
        }
      }
    },
    "pluginsReviewDecline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decline"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reddet"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відхилити"
          }
        }
      }
