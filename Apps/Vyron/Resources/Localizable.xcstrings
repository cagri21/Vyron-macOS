    "noTasksBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Schedule a prompt once, daily, or weekly. Vyron keeps the results in your chats."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir istemi bir kez, her gün veya her hafta çalışacak şekilde zamanlayın. Vyron sonuçları sohbetlerinizde saklar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заплануйте виконання запиту один раз, щодня або щотижня. Vyron зберігає результати у ваших чатах."
          }
        }
      }
    },
    "executionNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs while Vyron is open and your Mac is awake. After sleep or reopening, an overdue schedule runs once. Vyron does not wake your Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyron açıkken ve Mac’iniz uyanıkken çalışır. Uyku veya yeniden açılma sonrasında gecikmiş bir zamanlama bir kez çalışır. Vyron Mac’inizi uyandırmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Працює, коли Vyron відкрито, а Mac не перебуває в режимі сну. Після пробудження або повторного відкриття прострочене завдання виконується один раз. Vyron не пробуджує Mac."
          }
        }
      }
    },
    "reviewNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduled tasks keep the same command review and connected-tool permissions as interactive tasks."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanlanmış görevlerde de etkileşimli görevlerle aynı komut incelemesi ve bağlı araç izinleri geçerlidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для запланованих завдань діють ті самі перевірки команд і дозволи підключених інструментів, що й для інтерактивних завдань."
          }
        }
      }
    },
