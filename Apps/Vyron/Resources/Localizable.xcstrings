    "appInspectorChangesHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows edits made through the agent’s file tools. Commands can also change project files. Revert preserves any newer edits you made."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajanın dosya araçlarıyla yaptığı düzenlemeleri gösterir. Komutlar da proje dosyalarını değiştirebilir. Geri alma, sizin daha yeni düzenlemelerinizi korur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує зміни, внесені файловими інструментами агента. Команди також можуть змінювати файли проєкту. Відкочування зберігає ваші новіші зміни."
          }
        }
      }
    },
