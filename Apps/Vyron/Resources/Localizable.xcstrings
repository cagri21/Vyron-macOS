      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter 0–1,000,000,000 USD with up to 8 decimal places. Leave out thousands separators."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fazla 8 ondalık basamakla 0–1.000.000.000 USD girin. Binlik ayırıcı kullanmayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть від 0 до 1 000 000 000 USD, до 8 знаків після коми, без розділювачів тисяч."
          }
        }
      }
    },
    "estimatedBalanceExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your OpenAI balance. Vyron subtracts estimated costs for requests made through this connection. Spending elsewhere, top-ups, and expired credits are not tracked. Update the amount to match billing."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI bakiyenizi girin. Vyron bu bağlantıyla yapılan isteklerin tahmini maliyetini düşer. Başka yerdeki harcamalar, yüklemeler ve süresi dolan krediler izlenmez. Tutarı faturalandırmayla eşleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть баланс OpenAI. Vyron відніматиме орієнтовну вартість запитів через це підключення. Витрати в інших місцях, поповнення та прострочені кредити не враховуються. Оновлюйте суму за даними оплати."
          }
        }
      }
    },
    "estimatedBalanceUntrackedUsage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some requests could not be priced or did not return usage. The estimate may be too high. Check billing and enter your current balance again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı isteklerin fiyatı hesaplanamadı veya kullanım bilgisi gelmedi. Tahmin yüksek olabilir. Faturalandırmayı kontrol edip güncel bakiyenizi yeniden girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для деяких запитів не вдалося визначити вартість або отримати дані використання. Оцінка може бути завищеною. Перевірте оплату та знову введіть поточний баланс."
          }
        }
      }
    },
    "estimatedBalanceStorageError": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The estimate could not be loaded or saved. It may not survive restarting Vyron. Check billing before relying on this amount."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahmin yüklenemedi veya kaydedilemedi. Vyron yeniden başlatıldığında korunmayabilir. Bu tutara güvenmeden önce faturalandırmayı kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити або зберегти оцінку. Вона може не зберегтися після перезапуску Vyron. Перевірте оплату, перш ніж покладатися на цю суму."
          }
        }
      }
    },
    "estimatedBalanceCheckEstimate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimate needs attention. Open balance details."
