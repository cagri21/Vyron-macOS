    "voiceDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speak naturally with your selected AI model. Vyron listens, sends your words in Chat mode, and reads the reply aloud."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtiğiniz yapay zekâ modeliyle doğal bir şekilde konuşun. Vyron dinler, sözlerinizi Sohbet modunda gönderir ve yanıtı sesli okur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спілкуйтеся природно з вибраною моделлю ШІ. Vyron слухає, надсилає ваші слова в режимі Чат і читає відповідь уголос."
          }
        }
      }
    },
    "voiceVoice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI voice"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zekâ sesi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Голос ШІ"
          }
        }
      }
    },
    "voicePreview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview voice"
          }
        },
        "tr": {
