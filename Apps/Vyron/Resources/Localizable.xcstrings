    "screenshotPromptTooLong": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This message and its images exceed the analysis context limit. Shorten the message or attach fewer images; your draft is preserved."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ileti ve resimleri analiz bağlamı sınırını aşıyor. İletiyi kısaltın veya daha az resim ekleyin; taslağınız korunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомлення із зображеннями перевищує ліміт контексту. Скоротіть текст або додайте менше зображень; чернетку збережено."
          }
        }
      }
    },
    "screenshotInvalidRole": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images can only be attached to user messages."
          }
