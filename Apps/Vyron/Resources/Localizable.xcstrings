          "stringUnit": {
            "state": "translated",
            "value": "Claude returned malformed native tool arguments."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude, yerleşik araç için hatalı biçimlendirilmiş bağımsız değişkenler döndürdü."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
