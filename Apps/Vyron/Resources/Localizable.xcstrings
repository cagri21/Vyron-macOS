      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick, Balanced, and Deep still adjust task budgets. They do not select the provider’s reasoning level."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı, Dengeli ve Derin seçenekleri görev bütçesini ayarlamaya devam eder. Sağlayıcının düşünme düzeyini seçmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Швидкий, Збалансований і Глибокий режими й далі змінюють бюджет завдання. Вони не задають рівень міркування провайдера."
          }
        }
      }
