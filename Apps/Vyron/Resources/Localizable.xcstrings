    "chromeInstalled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection enabled. In Chrome, open the Vyron extension and choose Connect this tab."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı etkinleştirildi. Chrome’da Vyron uzantısını açın ve Bu sekmeyi bağla’yı seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З’єднання ввімкнено. У Chrome відкрийте розширення Vyron і виберіть «Підключити цю вкладку»."
          }
        }
      }
    },
    "chromeSessions": {
      "extractionState": "manual",
