        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зробіть паузу, коли закінчите говорити, щоб надіслати повідомлення."
          }
        }
      }
    },
    "voiceDictationHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your words appear in the composer. Review them before sending."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sözleriniz mesaj alanında görünür. Göndermeden önce inceleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші слова з’являються в полі повідомлення. Перевірте їх перед надсиланням."
          }
        }
      }
    },
    "voiceInactive": {
      "extractionState": "manual",
      "localizations": {
