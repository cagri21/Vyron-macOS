    },
    "controlTargetNotVerified": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent stopped because the native target could not be verified."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel hedef doğrulanamadığı için ajan durduruldu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агента зупинено, оскільки не вдалося перевірити ціль у програмі."
          }
        }
      }
    },
    "controlProposalExpired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This proposal is out of date. Inspect the app and plan again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu önerinin süresi doldu. Uygulamayı inceleyin ve yeniden planlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця пропозиція застаріла. Перевірте програму та сплануйте знову."
          }
        }
      }
    },
    "controlTaskActionExpired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task stopped because its proposed action expired. Start again to read the current app state."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önerilen eylemin süresi dolduğu için görev durduruldu. Uygulamanın geçerli durumunu okumak için yeniden başlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завдання зупинено, оскільки запропонована дія застаріла. Почніть знову, щоб прочитати поточний стан програми."
          }
        }
      }
    },
    "controlFreshSnapshot": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresh snapshot captured locally."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncel anlık görüntü yerel olarak alındı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Свіжий знімок отримано локально."
          }
        }
      }
    },
    "controlActionSent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Action sent. Inspect the app again to verify the result."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eylem gönderildi. Sonucu doğrulamak için uygulamayı yeniden inceleyin."
