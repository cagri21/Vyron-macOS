    "appAutomationActiveGoalHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only works while this goal is active. Native app checks decide which actions can run. Stop cancels queued work."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu hedef etkin olduğu sürece çalışır. Hangi eylemlerin çalışabileceğini yerel uygulama denetimleri belirler. Durdurma, sıradaki işleri iptal eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Працює лише поки ця ціль активна. Нативні перевірки програми визначають дозволені дії. Зупинка скасовує роботу в черзі."
          }
        }
      }
    },
    "appAutomationFreshReadsHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresh reads happen automatically. Each control action waits for your review. Stop cancels all queued work."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncel okumalar otomatik yapılır. Her denetim eylemi incelemenizi bekler. Durdurma, sıradaki tüm işleri iptal eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стан оновлюється автоматично. Кожна дія керування чекає на ваш перегляд. Зупинка скасовує всю роботу в черзі."
          }
        }
      }
    },
