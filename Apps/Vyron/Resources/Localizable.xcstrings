    "appSettingsAutomaticDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chooses a compatible installed coding model. The large manual-only option and the small helper stay out of coding Auto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyumlu, yüklü bir kodlama modeli seçer. Yalnızca elle seçilebilen büyük model ve küçük yardımcı, kodlama için otomatik seçime dahil edilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибирає сумісну встановлену модель для програмування. Велика модель лише для ручного вибору та мала допоміжна модель не входять до автоматичного вибору для програмування."
          }
        }
      }
    },
