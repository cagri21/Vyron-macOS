      }
    },
    "appSettingsPrecisionReplacementWarning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyron will remove %@ from this Mac after it verifies and selects %@. If the download or switch fails or is canceled, the current variant stays installed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyron, %2$@ sürümünü doğrulayıp seçtikten sonra %1$@ sürümünü bu Mac’ten kaldıracak. İndirme veya geçiş başarısız olursa ya da iptal edilirse mevcut sürüm yüklü kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyron видалить %@ із цього Mac після того, як перевірить і вибере %@. Якщо завантаження або перемикання завершиться помилкою чи його буде скасовано, поточний варіант залишиться встановленим."
          }
        }
      }
    },
