    },
    "privacySpeechRecognitionUsage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyron transcribes speech on this Mac for dictation, voice conversations, and attached audio files."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyron, dikte, sesli sohbetler ve ekli ses dosyaları için konuşmayı bu Mac’te metne dönüştürür."
