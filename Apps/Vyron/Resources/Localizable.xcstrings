          }
        }
      }
    },
    "controlStopBeforeMonitor": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop the current task before starting a separate change monitor."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrı bir değişiklik izleyicisi başlatmadan önce geçerli görevi durdurun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зупиніть поточне завдання перед запуском окремого відстеження змін."
          }
        }
      }
    },
    "controlMonitorPermission": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an app and allow Accessibility before starting the monitor."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
