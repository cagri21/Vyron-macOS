    "voicePreviewPhrase": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hello, I am Vyron. What would you like to work on today?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merhaba, ben Vyron. Bugün ne üzerinde çalışmak istersiniz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вітаю, я Vyron. Над чим ви хотіли б попрацювати сьогодні?"
          }
        }
      }
    },
    "voiceSystemDefault": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System default"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem varsayılanı"
