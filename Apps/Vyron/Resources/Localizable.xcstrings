    "voicePermissionConfiguration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the packaged Vyron app to use the microphone and speech recognition."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonu ve konuşma tanımayı kullanmak için paketlenmiş Vyron uygulamasını açın."
          }
