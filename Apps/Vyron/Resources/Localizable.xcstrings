        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає доступних встановлених голосів. Додайте голос у Системних параметрах."
          }
        }
      }
    },
    "voiceMicrophonePermission": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow microphone access for Vyron in System Settings → Privacy & Security → Microphone, then try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları → Gizlilik ve Güvenlik → Mikrofon bölümünde Vyron için mikrofon erişimine izin verip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте Vyron доступ до мікрофона в Системних параметрах → Приватність і безпека → Мікрофон, а потім спробуйте знову."
          }
        }
      }
    },
    "voiceSpeechPermission": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow speech recognition for Vyron in System Settings → Privacy & Security → Speech Recognition, then try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları → Gizlilik ve Güvenlik → Konuşma Tanıma bölümünde Vyron için konuşma tanımaya izin verip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте Vyron розпізнавання мовлення в Системних параметрах → Приватність і безпека → Розпізнавання мовлення, а потім спробуйте знову."
          }
        }
      }
    },
    "voiceRecognitionUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition is unavailable. Try again when it is ready."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşma tanıma kullanılamıyor. Hazır olduğunda yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розпізнавання мовлення недоступне. Спробуйте знову, коли воно буде готове."
          }
        }
      }
    },
    "voiceOnDeviceUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device speech recognition is unavailable for your current language. Add its speech support in System Settings, or choose a supported language."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli diliniz için aygıt üzerinde konuşma tanıma kullanılamıyor. Sistem Ayarları’ndan bu dilin konuşma desteğini ekleyin veya desteklenen bir dil seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розпізнавання мовлення на пристрої недоступне для поточної мови. Додайте підтримку її мовлення в Системних параметрах або виберіть підтримувану мову."
          }
        }
      }
    },
    "voiceMicrophoneUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No working microphone is available. Check your sound input in System Settings, then try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışan bir mikrofon bulunamadı. Sistem Ayarları’ndan ses girişinizi kontrol edip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає робочого мікрофона. Перевірте звуковий вхід у Системних параметрах і спробуйте знову."
          }
        }
      }
    },
    "voiceRecognitionFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition stopped unexpectedly. Check your microphone and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşma tanıma beklenmedik şekilde durdu. Mikrofonunuzu kontrol edip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розпізнавання мовлення несподівано зупинилося. Перевірте мікрофон і спробуйте знову."
          }
        }
      }
    },
    "voiceBusy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish or stop the current task before starting voice input."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesli girişi başlatmadan önce mevcut görevi tamamlayın veya durdurun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершіть або зупиніть поточне завдання перед початком голосового введення."
          }
        }
      }
    },
    "voiceDraftRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send or clear your draft before starting a live conversation."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı sohbet başlatmadan önce taslağınızı gönderin veya temizleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надішліть або очистьте чернетку перед початком розмови наживо."
          }
        }
      }
    },
    "voiceChatOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live conversation uses Chat mode."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı sohbet, Sohbet modunu kullanır."
          }
