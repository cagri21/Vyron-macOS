    "compactionInputTooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This compaction request is too large. Shorten its focus instructions or the latest message."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bağlam kısaltma isteği çok uzun. Odak yönergelerini veya son mesajı kısaltın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запит на скорочення контексту завеликий. Скоротіть вказівки щодо пріоритетів або останнє повідомлення."
          }
        }
      }
    },
    "compactionInvalidSummary": {
      "extractionState": "manual",
      "localizations": {
