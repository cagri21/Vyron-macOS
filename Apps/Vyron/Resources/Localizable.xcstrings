      }
    },
    "modelDomainImageInvalidRole": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images can only be attached to user messages."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görseller yalnızca kullanıcı mesajlarına eklenebilir."
