    "controlActionFailedStop": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task stopped after an action failed. Inspect the app before retrying."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir eylem başarısız olduğu için görev durduruldu. Yeniden denemeden önce uygulamayı inceleyin."
          }
