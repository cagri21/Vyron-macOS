    "appAutomationLocalRequired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose On this Mac in Manage Models to use computer controls. Custom connections are available for Chat, Plan, and project Agent tasks."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayar denetimlerini kullanmak için Model Yönetimi’nde Bu Mac’te seçeneğini seçin. Özel bağlantılar Sohbet, Plan ve proje Ajan görevleri için kullanılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для керування комп’ютером виберіть «На цьому Mac» у менеджері моделей. Власні підключення доступні для чату, планування й завдань агента в проєкті."
          }
        }
      }
    },
