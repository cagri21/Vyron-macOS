          }
        }
      }
    },
    "compactionCompleted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Context compacted. Earlier messages remain in chat history."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlam kısaltıldı. Önceki mesajlar sohbet geçmişinde korunuyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Контекст скорочено. Попередні повідомлення залишаються в історії чату."
          }
        }
      }
    },
    "compactionCompletedLimited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Context compacted from a bounded history excerpt. The full conversation remains in chat history."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmişin sınırlandırılmış bir bölümü özetlenerek bağlam kısaltıldı. Konuşmanın tamamı sohbet geçmişinde korunuyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Контекст скорочено на основі обмеженого фрагмента історії. Повна розмова залишається в історії чату."
          }
        }
      }
    },
    "compactionFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Context could not be compacted. The previous summary and full chat history are preserved."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlam kısaltılamadı. Önceki özet ve sohbet geçmişinin tamamı korunuyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося скоротити контекст. Попередній підсумок і повну історію чату збережено."
          }
        }
      }
    },
    "compactionNoHistory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a message before compacting this chat."
          }
